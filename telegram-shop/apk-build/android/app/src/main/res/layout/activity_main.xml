<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC">

    <FrameLayout
        android:id="@+id/main_wrap"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <FrameLayout
            android:id="@+id/error_wrap"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F8FAFC"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="📡"
                    android:textSize="42sp" />

                <TextView
                    android:id="@+id/error_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="Сервер склада недоступен"
                    android:textColor="#334155"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btn_retry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:backgroundTint="#0F766E"
                    android:text="Повторить подключение"
                    android:textAllCaps="false" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="Долгое нажатие на экране склада — настройки APK"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>

    <ScrollView
        android:id="@+id/setup_wrap"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <LinearLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:gravity="center"
                android:background="#0F766E"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📦"
                    android:textSize="28sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Склад"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Telegram Shop • Android wrapper для склада"
                android:textSize="14sp"
                android:textColor="#64748B"
                android:paddingTop="4dp"
                android:paddingBottom="18dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚙️ Настройки подключения"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Адрес склада хранится в настройках APK. Здесь можно ввести адрес вручную, открыть deep link, отсканировать QR-код со страницы загрузки или сменить сервер позже."
                    android:textSize="13sp"
                    android:textColor="#64748B"
                    android:paddingTop="6dp"
                    android:paddingBottom="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Адрес сервера"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A" />

                <EditText
                    android:id="@+id/url_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#F1F5F9"
                    android:hint="https://myshop.ru/warehouse/"
                    android:inputType="textUri"
                    android:importantForAutofill="no"
                    android:minHeight="52dp"
                    android:padding="14dp"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/setup_error"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#DC2626"
                    android:textSize="13sp"
                    android:visibility="gone"
                    android:paddingTop="8dp" />

                <Button
                    android:id="@+id/btn_connect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Сохранить и открыть склад"
                    android:textAllCaps="false"
                    android:backgroundTint="#0F766E" />

                <Button
                    android:id="@+id/btn_back"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Вернуться в склад"
                    android:textAllCaps="false"
                    android:visibility="gone"
                    android:backgroundTint="#E2E8F0"
                    android:textColor="#0F172A" />

                <Button
                    android:id="@+id/btn_reset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Сбросить сохранённый адрес"
                    android:textAllCaps="false"
                    android:visibility="gone"
                    android:backgroundTint="#FEE2E2"
                    android:textColor="#991B1B" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#ECFEFF"
                android:padding="16dp"
                android:layout_marginTop="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Быстрая настройка"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A" />

                <TextView
                    android:id="@+id/setup_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Можно открыть ссылку настройки из браузера."
                    android:textSize="13sp"
                    android:textColor="#155E75"
                    android:paddingTop="8dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:layout_marginTop="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Обновления APK"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A" />

                <TextView
                    android:id="@+id/update_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Проверка станет доступна после подключения к серверу. Камера для сканера запросится при первом запуске сканирования."
                    android:textSize="13sp"
                    android:textColor="#475569"
                    android:paddingTop="8dp" />

                <Button
                    android:id="@+id/btn_update"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Скачать обновление"
                    android:textAllCaps="false"
                    android:visibility="gone"
                    android:backgroundTint="#DBEAFE"
                    android:textColor="#1D4ED8" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:layout_marginTop="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="О приложении"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A" />

                <TextView
                    android:id="@+id/app_meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#475569"
                    android:paddingTop="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Подключение к складу находится в настройках APK\n• Адрес можно сменить без пересборки приложения\n• Если путь не указан, приложение добавит /warehouse/ автоматически\n• Камера в WebView используется для сканирования QR и штрих-кодов\n• Новую версию APK можно отследить прямо из экрана настроек"
                    android:textSize="12sp"
                    android:textColor="#64748B"
                    android:paddingTop="10dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
