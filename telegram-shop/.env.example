# Токен бота от @BotFather (пусто = бот выключен; получить: @BotFather → /newbot)
# ВАЖНО: не вписывайте сюда фейковые токены вида 123456:AAA — скрипты примут их за настоящие.
BOT_TOKEN=

# Telegram ID администраторов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=

# Пароль для входа в веб-админку /admin (ОБЯЗАТЕЛЬНО смените!)
ADMIN_PASSWORD=admin123

# HTTPS-адрес сайта (после запуска туннеля/деплоя), например https://xxx.trycloudflare.com
WEBAPP_URL=

# Провайдер оплаты по умолчанию: test | yookassa | tbank | cryptobot | stars
PAYMENT_PROVIDER=test

# Режим бота: polling | webhook (для webhook нужен WEBAPP_URL)
BOT_MODE=polling
WEBHOOK_PATH=/tg/webhook
WEBHOOK_SECRET=

# Хост и порт веб-сервера
HOST=0.0.0.0
PORT=8000

# Comma-separated browser origins; use * only for development
CORS_ORIGINS=*

# Optional token protecting /metrics
METRICS_TOKEN=

# Warehouse login attempts per IP per minute
AUTH_RATE_LIMIT=20

# Trusted Hosts (comma-separated); empty = allow all (development)
TRUSTED_HOSTS=

# Rate limits (requests per minute)
RATE_LIMIT_1C=120
RATE_LIMIT_API=600

# Warehouse session lifetime, days
WH_SESSION_TTL_DAYS=30

# Minimal free disk space, MB (alerts)
DISK_FREE_MIN_MB=500

# Firebase service account JSON (одна строка) для push покупательского приложения.
# Пусто = FCM выключен. Вписывается вручную на сервере, в git не коммитить.
FCM_CREDENTIALS_JSON=

# 1 = dry-run (реальные отправки запрещены, только диагностика). 0 — боевые
# отправки после staging-проверки FCM (блок 25, Фаза 5).
FCM_DRY_RUN=1
