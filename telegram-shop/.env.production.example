# Copy to .env on the VPS. Replace placeholders manually; never commit .env.
BOT_TOKEN=PASTE_TELEGRAM_BOT_TOKEN_HERE
ADMIN_IDS=PASTE_ADMIN_TELEGRAM_ID
ADMIN_PASSWORD=CHANGE_ME_LONG_PASSWORD
WEBAPP_URL=https://YOUR-DOMAIN.example
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=https://YOUR-DOMAIN.example
METRICS_TOKEN=GENERATE_RANDOM_TOKEN
AUTH_RATE_LIMIT=20

# Optional: choose DB mode in warehouse settings or keep VPS/SQLite.
# Supabase URL and keys are entered manually in admin settings.
# MySQL/MariaDB credentials are entered manually in admin settings.

# Optional S3 settings; configure in warehouse settings.
# S3_ENDPOINT=https://storage.yandexcloud.net
# S3_ACCESS_KEY=PASTE_ACCESS_KEY
# S3_SECRET_KEY=PASTE_SECRET_KEY
# S3_BUCKET=shop-photos
# S3_BACKUP_BUCKET=shop-backups

# Optional Yandex Disk OAuth token; enter manually in warehouse settings.
# YANDEX_DISK_TOKEN=PASTE_OAUTH_TOKEN
# YANDEX_DISK_PATH=app:/shop-photos/products
