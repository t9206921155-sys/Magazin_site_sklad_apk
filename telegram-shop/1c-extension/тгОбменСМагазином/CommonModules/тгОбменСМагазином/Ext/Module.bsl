// Обмен данными с интернет-магазином "Telegram Shop" (бот Telegram + сайт).
// Общий модуль расширения. Сервер, Вызов сервера, Привилегированный.
//
// Обмен двусторонний:
//  1. Каталог: 1С -> магазин (номенклатура, цены, фото, категории)
//  2. Заказы:  магазин -> 1С (создаются документы заказов)
//  3. Статусы: 1С -> магазин (проведённый заказ = "отправлен")
//
// Все объекты конфигурации ищутся по ИМЕНАМ из настроек обмена, поэтому
// расширение работает с типовыми конфигурациями (УТ 11, УНФ, КА, БП и др.)
// без изменения их структуры.

#Область Настройки

Функция НастройкиОбмена()
	Настройки = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	тгНастройкиОбмена.Ключ КАК Ключ,
		|	тгНастройкиОбмена.Значение КАК Значение
		|ИЗ
		|	РегистрСведений.тгНастройкиОбмена КАК тгНастройкиОбмена";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Настройки.Вставить(Выборка.Ключ, Выборка.Значение);
	КонецЦикла;
	Возврат Настройки;
КонецФункции

Функция ПолучитьНастройку(Ключ, ЗначениеПоУмолчанию = "") Экспорт
	Настройки = НастройкиОбмена();
	Значение = Настройки.Получить(Ключ);
	Если Значение = Неопределено Или ПустаяСтрока(Значение) Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	Возврат Значение;
КонецФункции

Процедура СохранитьНастройки(Настройки) Экспорт
	Набор = РегистрыСведений.тгНастройкиОбмена.СоздатьНаборЗаписей();
	Для каждого КЗ Из Настройки Цикл
		Запись = Набор.Добавить();
		Запись.Ключ = КЗ.Ключ;
		Запись.Значение = Строка(КЗ.Значение);
	КонецЦикла;
	Набор.Записать(Истина);
КонецПроцедуры

Функция АдресМагазина()
	Адрес = ПолучитьНастройку("АдресМагазина");
	Если Прав(Адрес, 1) = "/" Тогда
		Адрес = Лев(Адрес, СтрДлина(Адрес) - 1);
	КонецЕсли;
	Возврат Адрес;
КонецФункции

#КонецОбласти

#Область HTTP

Функция РазобратьURL(URL)
	Рез = Новый Структура("Протокол,Хост,Путь", "", "", "");
	Поз = СтрНайти(URL, "://");
	Если Поз = 0 Тогда
		Возврат Рез;
	КонецЕсли;
	Рез.Протокол = НРег(Лев(URL, Поз - 1));
	Остаток = Сред(URL, Поз + 3);
	ПозСлэш = СтрНайти(Остаток, "/");
	Если ПозСлэш = 0 Тогда
		Рез.Хост = Остаток;
		Рез.Путь = "/";
	Иначе
		Рез.Хост = Лев(Остаток, ПозСлэш - 1);
		Рез.Путь = Сред(Остаток, ПозСлэш);
	КонецЕсли;
	Возврат Рез;
КонецФункции

Функция ВыполнитьHTTPЗапрос(Метод, URL, ДанныеJSON = "") Экспорт
	УРЛ = РазобратьURL(URL);
	Защищенное = УРЛ.Протокол = "https";
	Порт = ?(Защищенное, 443, 80);
	Соединение = Новый HTTPСоединение(УРЛ.Хост, Порт, , , , 30, Защищенное);

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("X-1C-Token", ПолучитьНастройку("Токен1С"));
	Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

	Запрос = Новый HTTPЗапрос(УРЛ.Путь, Заголовки);
	Если Не ПустаяСтрока(ДанныеJSON) Тогда
		Запрос.УстановитьТелоИзСтроки(ДанныеJSON, "UTF-8");
	КонецЕсли;

	Ответ = Соединение.ВызватьHTTPМетод(Метод, Запрос);
	Код = Ответ.КодСостояния;
	ТелоСтрокой = Ответ.ПолучитьТелоКакСтроку("UTF-8");
	Если Код >= 400 Тогда
		ВызватьИсключение "Ошибка сервера магазина (" + Код + "): " + Лев(ТелоСтрокой, 500);
	КонецЕсли;
	Возврат ТелоСтрокой;
КонецФункции

#КонецОбласти

#Область ВыгрузкаКаталога

Функция ПолучитьКартинкуНоменклатуры(Номенклатура)
	Попытка
		НачалоКартинки = Номенклатура.ПолучитьНачалоКартинки();
		Если НачалоКартинки = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат НачалоКартинки.ПолучитьДвоичныеДанные();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Функция ЦенаНоменклатуры(Номенклатура, ИмяРегистраЦен)
	Если ПустаяСтрока(ИмяРегистраЦен) Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Цены.Цена КАК Цена
			|ИЗ
			|	РегистрСведений." + ИмяРегистраЦен + " КАК Цены
			|ГДЕ
			|	Цены.Номенклатура = &Номенклатура
			|УПОРЯДОЧИТЬ ПО
			|	Цены.Период УБЫВ";
		Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Цена;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат 0;
КонецФункции

Функция ВыгрузитьКаталогВМагазин() Экспорт
	Лог = "Выгрузка каталога в магазин...";
	ИмяСправочника = ПолучитьНастройку("СправочникНоменклатуры", "Номенклатура");
	ИмяРегистраЦен = ПолучитьНастройку("РегистрЦен", "ЦеныНоменклатуры");

	Товары = Новый Массив;
	Количество = 0;
	Выборка = Справочники[ИмяСправочника].Выбрать();
	Пока Выборка.Следующий() Цикл
		// только элементы (без групп)
		Если Выборка.ЭтоГруппа Тогда
			Продолжить;
		КонецЕсли;
		Карточка = Новый Структура;
		Карточка.Вставить("code", СокрЛП(Выборка.Код));
		Карточка.Вставить("name", СокрЛП(Выборка.Наименование));
		Карточка.Вставить("price", ЦенаНоменклатуры(Выборка.Ссылка, ИмяРегистраЦен));
		Карточка.Вставить("description", СокрЛП(Выборка.Наименование));
		Родитель = Выборка.Родитель;
		Если Родитель = Справочники[ИмяСправочника].ПустаяСсылка() Тогда
			Карточка.Вставить("category", "");
		Иначе
			Карточка.Вставить("category", Строка(Родитель));
		КонецЕсли;
		ДвоичныеДанные = ПолучитьКартинкуНоменклатуры(Выборка.Ссылка);
		Если ДвоичныеДанные <> Неопределено Тогда
			Карточка.Вставить("photo_base64", Base64Строка(ДвоичныеДанные));
		КонецЕсли;
		Товары.Добавить(Карточка);
		Количество = Количество + 1;
	КонецЦикла;

	Данные = Новый Структура("products", Товары);
	Ответ = ВыполнитьHTTPЗапрос("POST", АдресМагазина() + "/1c/catalog", ЗаписатьJSON(Данные));
	Результат = ПрочитатьJSON(Ответ);
	Лог = Лог + Символы.ПС + "Выгружено позиций: " + Количество
		+ ". В магазине: создано " + Результат.created + ", обновлено " + Результат.updated + ".";
	Возврат Лог;
КонецФункции

#КонецОбласти

#Область ЗагрузкаЗаказов

Функция НайтиИлиСоздатьНоменклатуру(СтрокаЗаказа, ИмяСправочника)
	Справочник = Справочники[ИмяСправочника];
	Код = СокрЛП(СтрокаЗаказа.code);
	Номенклатура = Неопределено;
	Если Не ПустаяСтрока(Код) Тогда
		Попытка
			Номенклатура = Справочник.НайтиПоКоду(Код);
		Исключение
		КонецПопытки;
	КонецЕсли;
	Если Номенклатура = Неопределено Тогда
		Попытка
			Номенклатура = Справочник.НайтиПоНаименованию(СтрокаЗаказа.name, Истина);
		Исключение
		КонецПопытки;
	КонецЕсли;
	Если Номенклатура = Неопределено Тогда
		Новая = Справочник.СоздатьЭлемент();
		Новая.Наименование = СокрЛП(СтрокаЗаказа.name);
		Попытка
			Новая.Код = Код;
		Исключение
		КонецПопытки;
		Новая.Записать();
		Номенклатура = Новая.Ссылка;
	КонецЕсли;
	Возврат Номенклатура;
КонецФункции

Функция НайтиИлиСоздатьКонтрагента(Клиент, ИмяКонтрагенты)
	Справочник = Справочники[ИмяКонтрагенты];
	Телефон = СокрЛП(Клиент.phone);
	Если Не ПустаяСтрока(Телефон) Тогда
		Попытка
			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ ПЕРВЫЕ 1
				|	Контрагенты.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник." + ИмяКонтрагенты + " КАК Контрагенты
				|ГДЕ
				|	Контрагенты.Наименование ПОДОБНО &Шаблон";
			Запрос.УстановитьПараметр("Шаблон", "%" + Телефон + "%");
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Возврат Выборка.Ссылка;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
	НовыйК = Справочник.СоздатьЭлемент();
	НовыйК.Наименование = СокрЛП(Клиент.name) + " (магазин Telegram)";
	Попытка
		НовыйК.Комментарий = "Телефон: " + Телефон + ". Адрес: " + СокрЛП(Клиент.address);
	Исключение
	КонецПопытки;
	НовыйК.Записать();
	Возврат НовыйК.Ссылка;
КонецФункции

Процедура СоздатьДокументЗаказа(Заказ, ИмяДокумента, ИмяСправочника, ИмяКонтрагенты, ИмяТЧ)
	Документ = Документы[ИмяДокумента].СоздатьДокумент();
	Документ.Дата = ТекущаяДата();

	РеквизитВнешнийНомер = ПолучитьНастройку("РеквизитВнешнийНомер", "");
	Если Не ПустаяСтрока(РеквизитВнешнийНомер) Тогда
		Попытка
			Документ[РеквизитВнешнийНомер] = Заказ.id;
		Исключение
		КонецПопытки;
	КонецЕсли;

	Попытка
		Документ.Контрагент = НайтиИлиСоздатьКонтрагента(Заказ.customer, ИмяКонтрагенты);
	Исключение
	КонецПопытки;

	ТЧ = Документ[ИмяТЧ];
	Для каждого СтрокаЗаказа Из Заказ.items Цикл
		НоваяСтрока = ТЧ.Добавить();
		Попытка
			НоваяСтрока.Номенклатура = НайтиИлиСоздатьНоменклатуру(СтрокаЗаказа, ИмяСправочника);
		Исключение
		КонецПопытки;
		Попытка НоваяСтрока.Количество = Число(СтрокаЗаказа.qty); Исключение КонецПопытки;
		Попытка НоваяСтрока.Цена = Число(СтрокаЗаказа.price); Исключение КонецПопытки;
		Попытка НоваяСтрока.Сумма = Число(СтрокаЗаказа.price) * Число(СтрокаЗаказа.qty); Исключение КонецПопытки;
	КонецЦикла;

	Комментарий = "Заказ из магазина Telegram: " + Заказ.id + Символы.ПС
		+ "Клиент: " + СокрЛП(Заказ.customer.name) + ", тел.: " + СокрЛП(Заказ.customer.phone) + Символы.ПС
		+ "Адрес доставки: " + СокрЛП(Заказ.customer.address) + Символы.ПС
		+ "Доставка: " + Заказ.delivery.label + Символы.ПС
		+ СокрЛП(Заказ.customer.comment);
	Попытка
		Документ.Комментарий = Комментарий;
	Исключение
	КонецПопытки;

	Попытка
		Документ.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Документ.Записать();
	КонецПопытки;
КонецПроцедуры

Функция ЗагрузитьЗаказыИзМагазина() Экспорт
	Лог = "Загрузка заказов из магазина...";
	ИмяДокумента = ПолучитьНастройку("ДокументЗаказ", "ЗаказКлиента");
	ИмяСправочника = ПолучитьНастройку("СправочникНоменклатуры", "Номенклатура");
	ИмяКонтрагенты = ПолучитьНастройку("СправочникКонтрагенты", "Контрагенты");
	ИмяТЧ = ПолучитьНастройку("ТЧТовары", "Товары");

	URL = АдресМагазина() + "/1c/orders?synced=0&status=paid,processing,shipped";
	Ответ = ВыполнитьHTTPЗапрос("GET", URL);
	Данные = ПрочитатьJSON(Ответ);
	Заказы = Данные.orders;

	ВыгруженоИД = Новый Массив;
	Для каждого Заказ Из Заказы Цикл
		Попытка
			СоздатьДокументЗаказа(Заказ, ИмяДокумента, ИмяСправочника, ИмяКонтрагенты, ИмяТЧ);
			ВыгруженоИД.Добавить(Заказ.id);
			Лог = Лог + Символы.ПС + "Заказ " + Заказ.id + " -> документ " + ИмяДокумента + ".";
		Исключение
			Лог = Лог + Символы.ПС + "Ошибка по заказу " + Заказ.id + ": " + ОписаниеОшибки();
		КонецПопытки;
	КонецЦикла;

	Если ВыгруженоИД.Количество() > 0 Тогда
		Подтверждение = Новый Структура("ids", ВыгруженоИД);
		ВыполнитьHTTPЗапрос("POST", АдресМагазина() + "/1c/orders/ack", ЗаписатьJSON(Подтверждение));
		Лог = Лог + Символы.ПС + "Подтверждена выгрузка: " + ВыгруженоИД.Количество() + " зак.";
	КонецЕсли;
	Возврат Лог;
КонецФункции

#КонецОбласти

#Область СтатусыОтгрузки

Функция НайтиДокументПоВнешнемуНомеру(ВнешнийНомер, ИмяДокумента)
	РеквизитВнешнийНомер = ПолучитьНастройку("РеквизитВнешнийНомер", "");
	Если ПустаяСтрока(РеквизитВнешнийНомер) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Док.Ссылка КАК Ссылка
			|ИЗ
			|	Документ." + ИмяДокумента + " КАК Док
			|ГДЕ
			|	Док." + РеквизитВнешнийНомер + " = &Номер";
		Запрос.УстановитьПараметр("Номер", ВнешнийНомер);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

Функция ОтметитьОтгруженныеВМагазине() Экспорт
	Лог = "Передача статусов отгрузки в магазин...";
	ИмяДокумента = ПолучитьНастройку("ДокументЗаказ", "ЗаказКлиента");
	URL = АдресМагазина() + "/1c/orders?synced=1&status=paid,processing";
	Ответ = ВыполнитьHTTPЗапрос("GET", URL);
	Данные = ПрочитатьJSON(Ответ);

	Отправлено = 0;
	Для каждого Заказ Из Данные.orders Цикл
		Попытка
			Документ = НайтиДокументПоВнешнемуНомеру(Заказ.id, ИмяДокумента);
			Если Документ = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если Документ.Проведен Тогда
				Статус = Новый Структура;
				Статус.Вставить("id", Заказ.id);
				Статус.Вставить("status", "shipped");
				ВыполнитьHTTPЗапрос("POST", АдресМагазина() + "/1c/orders/status", ЗаписатьJSON(Статус));
				Отправлено = Отправлено + 1;
			КонецЕсли;
		Исключение
			Лог = Лог + Символы.ПС + ОписаниеОшибки();
		КонецПопытки;
	КонецЦикла;
	Лог = Лог + Символы.ПС + "Передано статусов: " + Отправлено + ".";
	Возврат Лог;
КонецФункции

#КонецОбласти
