// Модуль формы обработки "тгОбменСМагазином"

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ПрочитатьНастройкиНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПрочитатьНастройкиНаСервере()
	АдресМагазина = тгОбменСМагазином.ПолучитьНастройку("АдресМагазина");
	Токен1С = тгОбменСМагазином.ПолучитьНастройку("Токен1С");
	СправочникНоменклатуры = тгОбменСМагазином.ПолучитьНастройку("СправочникНоменклатуры", "Номенклатура");
	ДокументЗаказ = тгОбменСМагазином.ПолучитьНастройку("ДокументЗаказ", "ЗаказКлиента");
	СправочникКонтрагенты = тгОбменСМагазином.ПолучитьНастройку("СправочникКонтрагенты", "Контрагенты");
	ТЧТовары = тгОбменСМагазином.ПолучитьНастройку("ТЧТовары", "Товары");
	РегистрЦен = тгОбменСМагазином.ПолучитьНастройку("РегистрЦен", "ЦеныНоменклатуры");
	РеквизитВнешнийНомер = тгОбменСМагазином.ПолучитьНастройку("РеквизитВнешнийНомер");
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиНаСервере()
	Настройки = Новый Соответствие;
	Настройки.Вставить("АдресМагазина", СокрЛП(АдресМагазина));
	Настройки.Вставить("Токен1С", СокрЛП(Токен1С));
	Настройки.Вставить("СправочникНоменклатуры", СокрЛП(СправочникНоменклатуры));
	Настройки.Вставить("ДокументЗаказ", СокрЛП(ДокументЗаказ));
	Настройки.Вставить("СправочникКонтрагенты", СокрЛП(СправочникКонтрагенты));
	Настройки.Вставить("ТЧТовары", СокрЛП(ТЧТовары));
	Настройки.Вставить("РегистрЦен", СокрЛП(РегистрЦен));
	Настройки.Вставить("РеквизитВнешнийНомер", СокрЛП(РеквизитВнешнийНомер));
	тгОбменСМагазином.СохранитьНастройки(Настройки);
КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройки(Команда)
	СохранитьНастройкиНаСервере();
	ПоказатьПредупреждение(, "Настройки обмена сохранены");
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьКаталог(Команда)
	ДобавитьВЖурнал(ВыгрузитьКаталогНаСервере());
КонецПроцедуры

&НаСервере
Функция ВыгрузитьКаталогНаСервере()
	Попытка
		Возврат тгОбменСМагазином.ВыгрузитьКаталогВМагазин();
	Исключение
		Возврат "Ошибка: " + ОписаниеОшибки();
	КонецПопытки;
КонецФункции

&НаКлиенте
Процедура ЗагрузитьЗаказы(Команда)
	ДобавитьВЖурнал(ЗагрузитьЗаказыНаСервере());
КонецПроцедуры

&НаСервере
Функция ЗагрузитьЗаказыНаСервере()
	Попытка
		Возврат тгОбменСМагазином.ЗагрузитьЗаказыИзМагазина();
	Исключение
		Возврат "Ошибка: " + ОписаниеОшибки();
	КонецПопытки;
КонецФункции

&НаКлиенте
Процедура ОтметитьОтгруженные(Команда)
	ДобавитьВЖурнал(ОтметитьОтгруженныеНаСервере());
КонецПроцедуры

&НаСервере
Функция ОтметитьОтгруженныеНаСервере()
	Попытка
		Возврат тгОбменСМагазином.ОтметитьОтгруженныеВМагазине();
	Исключение
		Возврат "Ошибка: " + ОписаниеОшибки();
	КонецПопытки;
КонецФункции

Процедура ДобавитьВЖурнал(Текст)
	Журнал = Журнал + Символы.ПС + Текст;
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьЖурнал(Команда)
	Журнал = "";
КонецПроцедуры
